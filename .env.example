# --- Required ---
DISCORD_TOKEN=your_discord_bot_token
MONGODB_URI=mongodb://localhost:27017/novax

# --- Access control (comma-separated IDs, both optional) ---
# Only these servers may use the bot; slash commands register there on startup.
ALLOWED_GUILD_IDS=123456789012345678,234567890123456789
# Non-public commands need one of these roles (empty = everyone; admins always allowed).
ACCESS_ROLE_IDS=

# --- Optional ---
NODE_ENV=production
LOG_LEVEL=info
# Port for the built-in health server (Render injects PORT automatically; default 3007)
PORT=3007
# Optional: protects GET /status with "Authorization: Bearer <token>". /health stays open.
STATUS_TOKEN=
