# Discord
DISCORD_TOKEN=your-bot-token
MONGODB_URI=mongodb://127.0.0.1:27017/novax-guard

# Comma-separated guild ids the bot may operate in (empty = reject everything).
ALLOWED_GUILD_IDS=
# Comma-separated role ids allowed to use non-public commands (empty = everyone; admins always allowed).
ACCESS_ROLE_IDS=

# Optional
NODE_ENV=development
LOG_LEVEL=info
#PORT=3007
#STATUS_TOKEN=some-long-secret

# Minecraft RCON (module "minecraft", command /mc)
MC_RCON_HOST=
MC_RCON_PORT=25575
MC_RCON_PASSWORD=
# Comma-separated Discord user ids allowed to run /mc (empty = nobody).
MC_USER_IDS=1373389272606052474,1137557384173195385
MC_BOSS_COMMANDS=boss spawn
